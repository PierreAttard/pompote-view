# Local stack configuration (docker compose). Copy to `.env.local` and adjust.
#   cp .env.example .env.local
# `.env.local` is git-ignored; never commit real secrets.

# --- Timescale (local dev database; superuser used only by the migrate step) ---
POSTGRES_USER=pompote
POSTGRES_PASSWORD=pompote
POSTGRES_DB=pompote
POSTGRES_PORT=5432

# --- Read-only role the viz backend connects with (created by `migrate`) ---
VIZ_READER_PASSWORD=viz_reader

# --- robot_rust checkout whose migrations build the schema locally ---
# Path is relative to this repo root; its `crates/robot_rust/migrations` is
# bind-mounted read-only. robot_rust is never committed into this repo.
ROBOT_RUST_PATH=../robot_rust

# --- Viz backend ---
VIZ_API_KEY=dev-local-api-key
VIZ_API_PORT=8080
VIZ_DB_STATEMENT_TIMEOUT_MS=5000
VIZ_ENABLE_SWAGGER_UI=true

# --- Frontend (SvelteKit dev server) ---
FRONTEND_PORT=5173
